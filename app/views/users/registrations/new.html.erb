<%= stylesheet_link_tag "devise", "data-turbo-track": "reload" %>

<div class="auth-container">

  <h1 class="auth-title">🀄 新規登録</h1>

  <p class="auth-description">
    はじめてのまあじゃんへようこそ！
  </p>

  <div class="auth-card">

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>

      <%= render "devise/shared/error_messages", resource: resource %>

      <div class="auth-field">
  <%= f.label :name, "名前" %>
  <%= f.text_field :name, autofocus: true, autocomplete: "name", placeholder: "名前を入力" %>
</div>

      <div class="auth-field">
        <%= f.label :email, "メールアドレス" %>
        <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "メールアドレスを入力" %>
      </div>

      <div class="auth-field">
        <%= f.label :password, "パスワード" %>
        <%= f.password_field :password, autocomplete: "new-password", placeholder: "パスワードを入力" %>
      </div>

      <div class="auth-field">
        <%= f.label :password_confirmation, "パスワード（確認）" %>
        <%= f.password_field :password_confirmation, autocomplete: "new-password", placeholder: "もう一度入力" %>
      </div>

      <%= f.submit "アカウントを作成する", class: "auth-submit" %>

    <% end %>

  </div>

  <div class="auth-link">
    <%= render "devise/shared/links" %>
  </div>

</div>