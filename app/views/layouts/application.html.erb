<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Yuuhi" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=M+PLUS+Rounded+1c:wght@400;700;800&display=swap" rel="stylesheet">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <script src="https://kit.fontawesome.com/2a61574caf.js" crossorigin="anonymous"></script>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

<header>
     <div class="hamburger-menu">
        <input type="checkbox" id="menu-btn-check">
        <label for="menu-btn-check" class="menu-btn"><span></span></label>
        <div class="menu-content">
            <ul>
            <li>
              <%= link_to "ルール", rule_path %> 
            </li>

            <li>
               <%= link_to "役", yaku_path %>
            </li>

             <li>
               <%= link_to "投稿一覧", mypage_path %>
             </li>

            <li>
               <%= link_to "投稿", new_tweet_path %>
            </li>

            <li>
             <%= link_to "トップページ", root_path %>
            </li>
          </ul>
          </div>
        </div>
    </div>

    <div class="header-list">
      <ul>
        <% if user_signed_in? %>
        <li><%= button_to 'ログアウト', destroy_user_session_path, method: :delete %></li>
        <% else %>
        <li><%= link_to "新規登録", new_user_registration_path %></li>
        <li><%= link_to "ログイン", new_user_session_path %></li>
        <% end %>
      </ul>
    </div>

    <h1>
  <span>は</span><span>じ</span><span>め</span><span>て</span><span>の</span><span>ま</span><span>あ</span><span>じ</span><span>ゃ</span><span>ん</span>
</h1>
    
    </header>

  <body>
  <main>
    <%= yield %>
  </main>
  </body>

 
</html>


