<%= stylesheet_link_tag 'new', :media => "all" %>
<div class="post-container">
 <p class="title">新規投稿ページ</p>
<%= form_for @tweet do |f| %>

  <div class="field">
    <%= f.label :name %>
    <%= f.text_field :name, :size => 30 %>
  </div>


  <div class="field">
    <%= f.label :age  %>
    <%= f.number_field :age, :size => 10 %>
  </div>

   <div class="field">
    <%= f.label :image %>
    <%= f.file_field :image %>
  </div>
  
  <div class="field">
    <%= f.label :about  %>
    <%= f.text_area :about, :size => "30x2" %>
  </div>

  <%= f.submit "投稿する" %>
<% end %>
</div>

<%= link_to "一覧に戻る", tweets_path %>