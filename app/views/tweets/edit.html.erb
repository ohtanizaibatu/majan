<%= form_for @tweet do |f| %>
  <%= f.label :name %>
  <%= f.text_field :name, :size => 30 %> 
  <%= f.label :age  %>
  <%= f.number_field :age, :size => 10 %>
  <%= f.label :image %>
  <%= f.number_field :image, :size => 10 %>
  <%= f.label :about  %>
  <%= f.text_area :about, :size => "30x2" %>

  <%= f.submit "編集する" %>
<% end %>