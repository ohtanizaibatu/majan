<%= stylesheet_link_tag "edit", "data-turbo-track": "reload" %>

<div class="edit-container">

  <h1 class="edit-title">✏️ 投稿を編集</h1>

  <p class="edit-description">
    投稿内容を変更できます！
  </p>

  <div class="edit-card">

    <%= form_for @tweet do |f| %>

      <div class="edit-field">
        <%= f.label :name, "名前" %>
        <%= f.text_field :name, placeholder: "名前を入力してください" %>
      </div>

      <div class="edit-field">
        <%= f.label :age, "年齢" %>
        <%= f.number_field :age, placeholder: "年齢を入力してください" %>
      </div>

      <div class="edit-field">
        <%= f.label :image, "画像" %>
        <%= f.file_field :image %>
      </div>

      <div class="edit-field">
        <%= f.label :about, "投稿内容" %>
        <%= f.text_area :about,
            placeholder: "麻雀について自由に書いてみよう！" %>
      </div>

      <%= f.submit "変更を保存する", class: "edit-submit" %>

    <% end %>

  </div>

  <%= link_to "← 投稿詳細に戻る",
      tweet_path(@tweet.id),
      class: "edit-back" %>

</div>